# ─────────────────────────────────────────────────────────────
# Lead notification email (Resend)
# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values — this repository is public.
# ─────────────────────────────────────────────────────────────

# API key from the Resend account that sends lead notifications.
# Must belong to the same account that owns the sending domain or,
# when using the onboarding@resend.dev fallback below, the same
# account that owns the recipient address.
RESEND_API_KEY=re_your_api_key_here

# Where quote and contact leads are delivered.
# Defaults to info@ficekinsurance.com if unset.
LEAD_NOTIFICATION_EMAIL=info@ficekinsurance.com

# The "from" address on lead emails.
#
# Leave UNSET to fall back to Resend's shared testing sender,
# "Ficek Insurance Website <onboarding@resend.dev>". That fallback can
# only deliver to the email address that owns the Resend account —
# sending anywhere else fails with a 403 and no lead arrives.
#
# Set it once a domain is verified in Resend, preferring a subdomain so
# the website's automated mail cannot affect staff email deliverability:
# RESEND_FROM_EMAIL=Ficek Insurance Website <leads@send.ficekinsurance.com>
