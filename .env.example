# Resend API Key for lead notification emails
RESEND_API_KEY=re_your_api_key_here

# Recipient email for quote and contact leads (default: austin.l@ficekinsurance.com)
LEAD_NOTIFICATION_EMAIL=austin.l@ficekinsurance.com

# Verified sender email in Resend (default: Ficek Insurance Website <onboarding@resend.dev> or production domain)
RESEND_FROM_EMAIL=Ficek Insurance Website <onboarding@resend.dev>
